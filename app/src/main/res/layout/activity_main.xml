<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thai Truong Giang"
        android:textColor="@color/blue"
        android:textSize="25sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="50dp"
        android:text="2415053122313"
        android:textColor="@color/blue"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/edt_NameKC"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nhap ho va ten"
        android:padding="15dp"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/edt_Money"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="So Tien"
        android:padding="15dp"
        android:textSize="18sp" />

    <EditText
        android:id="@+id/edt_GhiChu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ghi chu"
        android:padding="15dp"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_Them"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:text="Them khoan chi"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/green" />

        <Button
            android:id="@+id/btn_Gui"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xem chi tiet"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>